# Copy to .env and fill in. Never commit real keys.

# xAI / Grok (primary LLM)
XAI_API_KEY=
XAI_MODEL=grok-4

# Embeddings (hash-local works offline; swap to voyage-finance-2 later)
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=hash-local
EMBEDDING_DIM=256

# Reranker (lexical is offline default; cohere reserved)
COHERE_API_KEY=
RERANKER_MODEL=lexical
RERANK_ENABLED=true
RERANK_POOL_K=24

# Vector store (QDRANT_IN_MEMORY=true uses qdrant-client :memory:)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fintruth_chunks
QDRANT_IN_MEMORY=true

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fintruth-rag
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Ingestion
SEC_USER_AGENT=FinTruthRAG contact@example.com
CATALOG_DB_PATH=data/catalog.db
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Logging
LOG_LEVEL=INFO
