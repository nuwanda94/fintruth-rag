# Copy to .env and fill in. Never commit real keys.

# xAI / Grok (primary LLM)
XAI_API_KEY=
XAI_MODEL=grok-4

# Embeddings (choose one path)
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=voyage-finance-2

# Reranker
COHERE_API_KEY=

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=fintruth_chunks

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fintruth-rag
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Ingestion
SEC_USER_AGENT=FinTruthRAG contact@example.com
CATALOG_DB_PATH=data/catalog.db
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Logging
LOG_LEVEL=INFO
